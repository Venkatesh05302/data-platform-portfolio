# =====================================================================
# .env.example — template for local development
# Copy this to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# --- LLM providers (used in future labs: RAG, agents) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: HuggingFace token (only needed for gated models) ---
# HF_TOKEN=hf_...

# --- Vector DBs (future labs) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- AWS (for AWS-tied labs) ---
# AWS_REGION=us-east-1
# AWS_PROFILE=default
